#!/usr/bin/env python3
"""Keep a Mac awake, then request sleep. No third-party dependencies."""

import argparse
import fcntl
import json
import math
import os
from pathlib import Path
import re
import signal
import socket
import subprocess
import sys
import time

# Inside the signed app, a bytecode cache would modify the bundle.
sys.dont_write_bytecode = True
from lid_awake import LidSession


ROOT = Path.home() / '.local/share/sleep-in'
SOCKET = ROOT / 'timer.sock'
STATE = ROOT / 'state.json'


def save(state):
    temporary = ROOT / 'state.tmp'
    temporary.write_text(json.dumps(state) + '\n')
    temporary.replace(STATE)


def request(command):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(3)
        try:
            client.connect(str(SOCKET))
        except (FileNotFoundError, ConnectionRefusedError):
            return None
        client.sendall(command.encode())
        return json.loads(client.recv(8192))


def duration(value):
    compact = re.sub(r'\s+', '', value.lower())
    if not re.fullmatch(r'(?:\d+(?:\.\d+)?[hms])+', compact):
        raise argparse.ArgumentTypeError('Use units, such as 45m, 1h, or 1h30m.')
    seconds = sum(float(number) * {'h': 3600, 'm': 60, 's': 1}[unit]
                  for number, unit in re.findall(r'(\d+(?:\.\d+)?)([hms])', compact))
    if not math.isfinite(seconds) or seconds < 1 or seconds > 604800:
        raise argparse.ArgumentTypeError('Choose a duration from 1 second to 7 days.')
    return seconds


def describe(state):
    if state['status'] == 'running':
        remaining = max(0, math.ceil(state['deadline'] - time.time()))
        hours, rest = divmod(remaining, 3600)
        minutes, seconds = divmod(rest, 60)
        end = time.strftime('%a %H:%M:%S', time.localtime(state['deadline']))
        action = 'Dry run ends' if state['dry_run'] else 'Mac sleeps'
        lid = ''
        if state.get('lid_closed'):
            lid = ' Lid closed: awake on charger.' if state.get('lid_awake') else ' Lid closed: connect charger to stay awake.'
        return f'{action} at {end} ({hours}h {minutes}m {seconds}s remaining).' + lid
    return state['message']


def run_timer(seconds, dry_run, lock, json_output, parent_pid, lid_closed=False, lid_helper=None):
    state = {'status': 'running', 'deadline': time.time() + seconds,
             'dry_run': dry_run, 'lid_closed': lid_closed, 'lid_awake': False}
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    stopping = False
    lid = None
    awake = None

    def cancelled():
        return stopping or (parent_pid is not None and os.getppid() != parent_pid)

    def stop(signum, frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGHUP, stop)
    last_display = None
    try:
        # -w releases the assertion even if this process is killed unexpectedly.
        awake = subprocess.Popen(['/usr/bin/caffeinate', '-i', '-s', '-w', str(os.getpid())])
        if lid_closed:
            if not json_output:
                print('Approve with Touch ID or your password to allow lid-closed use on the charger.', flush=True)
            lid = LidSession(lid_helper)
            if not lid.start(cancelled):
                stopping = True
        # Authorization time is not deducted from the countdown.
        state['deadline'] = time.time() + seconds
        if lid is not None and not cancelled():
            state['lid_awake'] = lid.update(state['deadline'])
        SOCKET.unlink(missing_ok=True)
        server.bind(str(SOCKET))
        os.chmod(SOCKET, 0o600)
        server.listen(4)
        server.settimeout(0.2)
        save(state)
        fcntl.flock(lock, fcntl.LOCK_UN)
        print(json.dumps(state) if json_output else describe(state), flush=True)
        if not json_output:
            print('Keep this terminal open. Press Ctrl+C to cancel.', flush=True)
        while not stopping and time.time() < state['deadline']:
            if cancelled():
                stopping = True
                break
            if lid is not None:
                lid_awake = lid.update(state['deadline'])
                if lid_awake != state['lid_awake']:
                    state['lid_awake'] = lid_awake
                    save(state)
                    if json_output:
                        print(json.dumps(state), flush=True)
            display = describe(state)
            if not json_output and sys.stdout.isatty() and display != last_display:
                print('\r\033[2K' + display, end='', flush=True)
                last_display = display
            if awake.poll() is not None:
                raise RuntimeError('The macOS keep-awake process stopped unexpectedly.')
            try:
                connection, _ = server.accept()
            except socket.timeout:
                continue
            with connection:
                connection.settimeout(1)
                try:
                    command = connection.recv(64).decode()
                    if command == 'cancel':
                        stopping = True
                        state.update(status='cancelled', message='Timer cancelled. Normal sleep settings restored.')
                        save(state)
                    elif command.startswith('extend '):
                        extra = float(command.split()[1])
                        if math.isfinite(extra) and extra > 0:
                            state['deadline'] = min(state['deadline'] + extra, time.time() + 604800)
                            save(state)
                            if json_output:
                                print(json.dumps(state), flush=True)
                    connection.sendall(json.dumps(state).encode())
                except (OSError, UnicodeError, ValueError, IndexError):
                    pass
        if cancelled():
            stopping = True
        # Restore sleep before requesting it, including while the lid is closed.
        if lid is not None:
            lid.close()
            lid = None
            state['lid_awake'] = False
        if stopping:
            state.update(status='cancelled', message='Timer cancelled. Normal sleep settings restored.')
        elif dry_run:
            state.update(status='completed', message='Dry run completed. No sleep command was sent.')
        else:
            state.update(status='completed', message='Timer expired; sleep requested from macOS.')
            save(state)
            result = subprocess.run(['/usr/bin/pmset', 'sleepnow'], capture_output=True, text=True, timeout=30)
            if result.returncode:
                raise RuntimeError(result.stderr.strip() or result.stdout.strip() or 'macOS rejected the sleep request.')
        save(state)
    except Exception as error:
        state.update(status='failed', message=f'Timer failed: {error}')
        save(state)
        raise
    finally:
        server.close()
        try:
            if lid is not None:
                lid.close()
        finally:
            if awake is not None:
                if awake.poll() is None:
                    awake.terminate()
                awake.wait()
            SOCKET.unlink(missing_ok=True)
    if not json_output and sys.stdout.isatty():
        print('\r\033[2K', end='')
    print(json.dumps(state) if json_output else describe(state), flush=True)


def main():
    global ROOT, SOCKET, STATE
    parser = argparse.ArgumentParser(
        description='Keep your Mac awake until a timer expires, then put it to sleep.',
        epilog='Examples: sleep-in 1h | sleep-in 1h30m | sleep-in extend 15m | sleep-in status | sleep-in cancel\n'
               'Runs in this terminal. Ctrl+C or closing Terminal cancels.\n'
               'Use --lid-closed for lid-closed use while plugged in (approve with Touch ID; needs the Sleep In app).',
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('action', help='Duration with h/m/s units, or status, cancel, or extend')
    parser.add_argument('amount', nargs='?', help='With extend: time to add, such as 15m')
    parser.add_argument('--dry-run', action='store_true', help='Keep awake for the duration but do not sleep at the end')
    parser.add_argument('--lid-closed', action='store_true', help='Also prevent lid-close sleep on AC power; asks for Touch ID')
    parser.add_argument('--lid-helper', type=Path, help=argparse.SUPPRESS)
    parser.add_argument('--replace', action='store_true', help='Replace an existing timer')
    parser.add_argument('--json', action='store_true', help='Print machine-readable timer events')
    parser.add_argument('--gui-parent', type=int, help=argparse.SUPPRESS)
    parser.add_argument('--state-dir', type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.state_dir is not None:
        ROOT = args.state_dir
        SOCKET = ROOT / 'timer.sock'
        STATE = ROOT / 'state.json'
    if args.gui_parent is not None and args.gui_parent != os.getppid():
        parser.error('The app that started this timer is no longer running.')
    if sys.platform != 'darwin':
        parser.error('This app requires macOS.')
    if args.action in ('status', 'cancel', 'extend') and (args.dry_run or args.replace or args.lid_closed or args.lid_helper):
        parser.error('--dry-run, --replace, and --lid-closed apply only when starting a timer.')
    if args.lid_helper is not None and not args.lid_closed:
        parser.error('--lid-helper requires --lid-closed.')
    if args.action == 'extend' and args.amount is None:
        parser.error('Say how much time to add, such as: sleep-in extend 15m')
    if args.action != 'extend' and args.amount is not None:
        parser.error(f'unrecognized arguments: {args.amount}')
    seconds = None
    if args.action not in ('status', 'cancel'):
        try:
            seconds = duration(args.amount if args.action == 'extend' else args.action)
        except argparse.ArgumentTypeError as error:
            parser.error(str(error))
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(ROOT, 0o700)
    # Serialize commands so simultaneous starts cannot create competing timers.
    with (ROOT / 'control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        active = request('status')
        if args.action == 'status':
            if active:
                print(json.dumps(active) if args.json else describe(active))
            elif STATE.exists():
                previous = json.loads(STATE.read_text())
                message = 'No timer is running. ' + (
                    'The previous timer was interrupted.' if previous['status'] == 'running' else describe(previous))
                print(json.dumps({'status': 'inactive', 'message': message}) if args.json else message)
            else:
                print(json.dumps({'status': 'inactive', 'message': 'No timer is running.'}) if args.json else 'No timer is running.')
            return
        if args.action == 'extend':
            updated = request(f'extend {seconds}') if active else None
            if not updated or updated['status'] != 'running':
                parser.exit(1, 'No timer is running.\n')
            print(json.dumps(updated) if args.json else describe(updated))
            return
        if active and args.action != 'cancel' and not args.replace:
            parser.exit(1, describe(active) + '\nUse --replace to change it, or sleep-in cancel to stop it.\n')
        if active and (args.action == 'cancel' or args.replace):
            request('cancel')
            deadline = time.monotonic() + 5
            while SOCKET.exists() and time.monotonic() < deadline:
                time.sleep(0.05)
            if SOCKET.exists():
                parser.exit(1, 'The previous timer is still stopping. Try again shortly.\n')
        if args.action == 'cancel':
            print('Timer cancelled. Normal sleep settings restored.' if active else 'No timer is running.')
            return
        run_timer(seconds, args.dry_run, lock, args.json, args.gui_parent, args.lid_closed, args.lid_helper)


if __name__ == '__main__':
    os.umask(0o077)
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
        sys.exit(f'sleep-in: {error}')
